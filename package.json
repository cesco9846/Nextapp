{
  "name": "glow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-env-proxy node_modules/next/dist/bin/next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node --use-env-proxy node_modules/next/dist/bin/next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:db": "node scripts/supabase.mjs test db",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "db:start": "node scripts/start-local.mjs",
    "db:reset": "node scripts/supabase.mjs db reset --local && python3 scripts/migrate.py --local --apply",
    "db:types": "node scripts/supabase.mjs gen types typescript --local > src/lib/database.types.ts",
    "db:migrate:local": "python3 scripts/migrate.py --local --apply"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fullcalendar/react": "7.1.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "temporal-polyfill": "1.0.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "type": "module"
}
